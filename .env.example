# Copy to .env (gitignored). Never commit real values. TESTNET ONLY: any NEAR_NETWORK other than testnet is refused at startup.
NEAR_NETWORK=testnet
# Comma-separated https RPC endpoints, tried in order (default shown).
NEAR_RPC_URL=https://test.rpc.fastnear.com
KEYHOLE_CONTRACT=keyhole.example.testnet

# Account that pays gas for relayed calls (open_session, close_session, certify_blob, attest_erasure). It can forge nothing.
RELAYER_ACCOUNT=
RELAYER_PRIVATE_KEY=

# Release service (services/release). Generated by tools/testnet; the signing key's public half is in the contract's rs_keys.
RS_SIGNING_SEED=
# 32-byte hex key that encrypts grant material and deal key halves at rest. Must differ from RS_SIGNING_SEED.
RS_STORE_KEY=
RS_IDX=0
RELEASE_PORT=8788
RELEASE_HOST=127.0.0.1
RELEASE_DATA_DIR=./data/release
RS_SEGMENTS_PER_MINUTE=30
RS_PER_IP_PER_MINUTE=600
# Testnet sponsorship (units of 0.5 NEAR: RS_SPONSOR_NEAR=1 gives 0.5 NEAR per new account)
RS_SPONSOR_MAX=20
RS_SPONSOR_NEAR=1

# Storage node (services/node). The public half of NODE_SEED is in the contract's node_keys at NODE_IDX.
NODE_SEED=
NODE_IDX=0
NODE_PORT=8787
NODE_HOST=127.0.0.1
NODE_DATA_DIR=./data/node
NODE_SWEEP_INTERVAL_MS=60000

# Written by tools/testnet (accounts and deploy keys for the smoke tests); also never committed.
OWNER_ACCOUNT=
OWNER_PRIVATE_KEY=
NODE_ACCOUNT=
NODE_ACCOUNT_PRIVATE_KEY=
# NEAR AI Cloud key: requested through the secure credential flow, never committed.
NEARAI_API_KEY=
