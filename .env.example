# Copy to .env. Never commit real values.
NEAR_NETWORK=testnet
KEYHOLE_CONTRACT=keyhole.example.testnet
# Release service and relayer keys are generated by scripts and kept in the host's secret store.
RS_SIGNING_SEED=
RELAYER_ACCOUNT=
RELAYER_PRIVATE_KEY=
NODE_SEED=
# NEAR AI Cloud key: requested through the secure credential flow, never committed.
NEARAI_API_KEY=
